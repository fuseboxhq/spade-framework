{
  "description": "SPADE mechanical guards. Deterministic checks over tool input and named local state; the rules are defined in docs/FRAMEWORK.md § Mechanical guards. Inert outside a repository with .spade/config.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/spade-guard",
            "timeout": 10,
            "statusMessage": "SPADE guards arming"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/spade-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/spade-guard",
            "timeout": 30,
            "statusMessage": "SPADE guard check"
          }
        ]
      }
    ]
  }
}

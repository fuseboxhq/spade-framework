#!/usr/bin/env bash
set -eu

# Spawn one allowlisted CLI agent in a new macOS terminal window.
# The prompt is opaque stdin data and the command contract is compiled here.
# Exit codes: 0 success, 1 usage, 2 unsupported host, 3 unavailable tool, 4 collision.

PROG="spade-handoff-launch"

usage() {
    # Contract: print the complete launcher interface.
    cat >&2 <<EOF
Usage: $PROG --terminal <iterm|terminal> --cwd <dir> --agent <claude|amp>
             [--autonomous] [--invoked-from <dir>] [--force-same-worktree]
             [--dry-run]

The handoff prompt is read from stdin.
EOF
}

die() {
    # Contract: print one error and terminate with the supplied status.
    echo "$PROG: $1" >&2
    exit "${2:-1}"
}

worktree_root() {
    # Contract: print the real worktree root for a directory, or an empty line.
    git -C "$1" rev-parse --show-toplevel 2>/dev/null || echo ""
}

shquote() {
    # Contract: quote one trusted argv value for the generated Bash script.
    printf '%q' "$1"
}

resolve_agent() {
    # Contract: resolve an allowlisted agent to a regular non-symlink executable.
    name="$1"
    path=$(command -v "$name" 2>/dev/null || true)
    [ -n "$path" ] || die "agent binary not found on PATH: $name" 3
    case "$path" in /*) : ;; *) die "agent did not resolve to an absolute path: $name" 3 ;; esac
    [ -f "$path" ] && [ -x "$path" ] && [ ! -L "$path" ] || die "agent binary must be a regular non-symlink executable: $path" 3
    directory=$(cd "$(dirname "$path")" && pwd -P) || die "agent directory cannot be resolved" 3
    printf '%s/%s\n' "$directory" "$(basename "$path")"
}

assert_trusted_agent_path() {
    # Contract: require user-or-root ownership and no group/world-writable path.
    path="$1"
    target="$2"
    trusted_uid=$(id -u)
    target_real=$(cd "$target" && pwd -P)
    case "$path" in "$target_real"|"$target_real"/*) die "agent binary resolves inside the target worktree" 3 ;; esac
    current="$path"
    while :; do
        metadata=$(stat -c '%u %a' "$current" 2>/dev/null || stat -f '%u %Lp' "$current" 2>/dev/null || true)
        [ -n "$metadata" ] || die "cannot inspect agent path ownership and permissions: $current" 3
        owner=${metadata%% *}
        mode=${metadata#* }
        case "$owner" in 0|"$trusted_uid") : ;; *) die "agent path has an untrusted owner: $current" 3 ;; esac
        permissions=$(printf '%s' "$mode" | sed 's/.*\([0-9][0-9][0-9]\)$/\1/')
        group=$(printf '%s' "$permissions" | cut -c2)
        world=$(printf '%s' "$permissions" | cut -c3)
        case "$group$world" in *2*|*3*|*6*|*7*) die "agent path has a group-or-world-writable component: $current" 3 ;; esac
        [ "$current" = "/" ] && break
        current=$(dirname "$current")
    done
}

resolve_digest_tool() {
    # Contract: select one trusted SHA-256 implementation for exec revalidation.
    if [ -x /usr/bin/shasum ] && [ ! -L /usr/bin/shasum ]; then
        DIGEST_TOOL=/usr/bin/shasum
        DIGEST_FLAG="-a 256"
    elif [ -x /usr/bin/sha256sum ] && [ ! -L /usr/bin/sha256sum ]; then
        DIGEST_TOOL=/usr/bin/sha256sum
        DIGEST_FLAG=""
    else
        die "no trusted SHA-256 tool is available" 3
    fi
}

TERMINAL=""
CWD=""
INVOKED_FROM=""
AGENT_NAME=""
AUTONOMOUS=0
FORCE_SAME_WORKTREE=0
DRY_RUN=0

while [ $# -gt 0 ]; do
    case "$1" in
        --terminal) shift; [ $# -gt 0 ] || die "--terminal requires a value"; TERMINAL="$1" ;;
        --cwd) shift; [ $# -gt 0 ] || die "--cwd requires a value"; CWD="$1" ;;
        --invoked-from) shift; [ $# -gt 0 ] || die "--invoked-from requires a value"; INVOKED_FROM="$1" ;;
        --agent) shift; [ $# -gt 0 ] || die "--agent requires a value"; AGENT_NAME="$1" ;;
        --autonomous) AUTONOMOUS=1 ;;
        --force-same-worktree) FORCE_SAME_WORKTREE=1 ;;
        --dry-run) DRY_RUN=1 ;;
        -h|--help) usage; exit 0 ;;
        *) usage; die "unknown argument '$1'" ;;
    esac
    shift
done

[ -n "$TERMINAL" ] || { usage; die "missing --terminal"; }
[ -n "$CWD" ] || { usage; die "missing --cwd"; }
[ -n "$AGENT_NAME" ] || { usage; die "missing --agent"; }
case "$TERMINAL" in iterm|terminal) : ;; *) die "--terminal must be 'iterm' or 'terminal'" ;; esac
case "$AGENT_NAME" in claude|amp) : ;; *) die "--agent must be 'claude' or 'amp'" ;; esac
[ -d "$CWD" ] && [ ! -L "$CWD" ] || die "--cwd must be a non-symlink directory: $CWD"
CWD=$(cd "$CWD" && pwd -P) || die "--cwd cannot be canonicalized"
CWD_ID=$(stat -c '%d:%i' "$CWD" 2>/dev/null || stat -f '%d:%i' "$CWD" 2>/dev/null || true)
[ -n "$CWD_ID" ] || die "--cwd identity cannot be recorded"

PROMPT=$(cat)
[ -n "$PROMPT" ] || die "empty handoff prompt"

if [ -n "$INVOKED_FROM" ]; then
    cwd_root=$(worktree_root "$CWD")
    invoked_root=$(worktree_root "$INVOKED_FROM")
    if [ -n "$cwd_root" ] && [ "$cwd_root" = "$invoked_root" ] && [ "$FORCE_SAME_WORKTREE" -ne 1 ]; then
        die "worktree collision: target and invoking session share $cwd_root" 4
    fi
fi

AGENT_BIN=$(resolve_agent "$AGENT_NAME")
assert_trusted_agent_path "$AGENT_BIN" "$CWD"
resolve_digest_tool
if [ -n "$DIGEST_FLAG" ]; then
    set -- $($DIGEST_TOOL -a 256 "$AGENT_BIN")
else
    set -- $($DIGEST_TOOL "$AGENT_BIN")
fi
AGENT_DIGEST="$1"
PROMPT_VIA="arg"
set -- "$AGENT_BIN"
case "$AGENT_NAME" in
    claude)
        set -- "$@" --permission-mode acceptEdits
        [ "$AUTONOMOUS" -eq 0 ] || set -- "$@" --dangerously-skip-permissions
        ;;
    amp)
        PROMPT_VIA="stdin"
        [ "$AUTONOMOUS" -eq 0 ] || set -- "$@" --dangerously-allow-all
        ;;
esac

AGENT_QUOTED=""
for value in "$@"; do AGENT_QUOTED="$AGENT_QUOTED $(shquote "$value")"; done
AGENT_QUOTED=${AGENT_QUOTED# }
CWD_QUOTED=$(shquote "$CWD")
AGENT_BIN_QUOTED=$(shquote "$AGENT_BIN")
DIGEST_TOOL_QUOTED=$(shquote "$DIGEST_TOOL")

generate_run_sh() {
    # Contract: emit a one-use script with no prompt interpolation in source.
    printf '%s\n' '#!/bin/bash'
    printf '%s\n' '# Generated by spade-handoff-launch for one SPADE handoff.'
    printf '%s\n' '_d="$(cd "$(dirname "$0")" && pwd)"'
    printf '%s\n' '_spade_prompt="$(cat "$_d/prompt.txt")"'
    printf '%s\n' 'rm -rf "$_d"'
    printf '%s\n' "[ \"\$(/usr/bin/stat -c '%d:%i' $CWD_QUOTED 2>/dev/null || /usr/bin/stat -f '%d:%i' $CWD_QUOTED 2>/dev/null)\" = '$CWD_ID' ] || { echo 'spade-handoff: target worktree changed after validation' >&2; exit 4; }"
    printf '%s\n' "cd $CWD_QUOTED || exit 1"
    printf '%s\n' "[ \"\$(pwd -P)\" = $CWD_QUOTED ] || { echo 'spade-handoff: target path changed after validation' >&2; exit 4; }"
    if [ -n "$DIGEST_FLAG" ]; then
        printf '%s\n' "set -- \$($DIGEST_TOOL_QUOTED -a 256 $AGENT_BIN_QUOTED)"
    else
        printf '%s\n' "set -- \$($DIGEST_TOOL_QUOTED $AGENT_BIN_QUOTED)"
    fi
    printf '%s\n' "[ \"\$1\" = '$AGENT_DIGEST' ] || { echo 'spade-handoff: agent binary changed after validation' >&2; exit 3; }"
    if [ "$PROMPT_VIA" = "arg" ]; then
        printf '%s\n' "exec $AGENT_QUOTED \"\$_spade_prompt\""
    else
        printf '%s\n' "printf '%s' \"\$_spade_prompt\" | exec $AGENT_QUOTED"
    fi
}

if [ "$DRY_RUN" -eq 1 ]; then
    echo "$PROG: dry run - nothing spawned"
    echo "  terminal: $TERMINAL"
    echo "  cwd: $CWD"
    echo "  agent: $AGENT_NAME"
    echo "  autonomous: $AUTONOMOUS"
    echo "  resolved-command: $AGENT_QUOTED"
    echo "  prompt-via: $PROMPT_VIA"
    echo "  --- generated run.sh ---"
    generate_run_sh | sed 's/^/  /'
    echo "  --- handoff prompt (verbatim) ---"
    printf '%s\n' "$PROMPT" | sed 's/^/  /'
    echo "  --- end ---"
    exit 0
fi

[ "$(uname)" = "Darwin" ] || die "handoff spawn requires macOS" 2
case "$TERMINAL" in
    iterm) osascript -e 'id of application "iTerm"' >/dev/null 2>&1 || die "iTerm is unavailable" 3 ;;
    terminal) osascript -e 'id of application "Terminal"' >/dev/null 2>&1 || die "Terminal.app is unavailable" 3 ;;
esac

TMP_BASE=${TMPDIR:-/tmp}
TMPD=$(mktemp -d "${TMP_BASE%/}/spade-handoff.XXXXXXXX") || die "could not create temp directory" 3
chmod 700 "$TMPD"
generate_run_sh > "$TMPD/run.sh"
printf '%s' "$PROMPT" > "$TMPD/prompt.txt"

spawn_iterm() {
    # Contract: ask iTerm to run only the quoted temporary script path.
    osascript - "$1" <<'OSA'
on run argv
    tell application "iTerm"
        activate
        set w to (create window with default profile)
        tell current session of w to write text "bash " & quoted form of (item 1 of argv)
    end tell
end run
OSA
}

spawn_terminal() {
    # Contract: ask Terminal to run only the quoted temporary script path.
    osascript - "$1" <<'OSA'
on run argv
    tell application "Terminal"
        activate
        do script "bash " & quoted form of (item 1 of argv)
    end tell
end run
OSA
}

case "$TERMINAL" in
    iterm) spawn_iterm "$TMPD/run.sh" || { rm -rf "$TMPD"; die "failed to open iTerm" 3; } ;;
    terminal) spawn_terminal "$TMPD/run.sh" || { rm -rf "$TMPD"; die "failed to open Terminal" 3; } ;;
esac
echo "$PROG: handoff launched in a new $TERMINAL window ($AGENT_NAME, cwd $CWD)."
